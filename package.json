{
  "name": "freedom-fiscal",
  "productName": "Freedom Fiscal",
  "version": "1.3.0",
  "description": "Ferramentas fiscais da Freedom Tech integradas à API do Tributei",
  "author": "Freedom Tech",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --x64 --publish never",
    "android:sync": "vite build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/core": "6.2.0",
    "@capacitor/filesystem": "6.0.2",
    "@capacitor/share": "6.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "6.2.0",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "vite": "5.4.11",
    "xlsx": "0.18.5",
    "pdfjs-dist": "^3.11.174",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2"
  },
  "build": {
    "appId": "br.com.cbfreedom.fiscal",
    "productName": "Freedom Fiscal",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Freedom Fiscal"
    },
    "portable": {
      "artifactName": "FreedomFiscal-portatil-${version}.exe"
    },
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "publish": null
  }
}